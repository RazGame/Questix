# Облачный .env (скопировать в .env на сервере рядом с docker-compose.cloud.yml)

# Mongo (придумайте длинный пароль)
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME_LONG_RANDOM

# --- Режим IP (по умолчанию, без HTTPS) ---
VITE_API_URL=http://81.90.28.28:8080
VITE_SOCKET_URL=http://81.90.28.28:8080
CORS_ORIGIN=http://81.90.28.28

# --- Режим с доменом (раскомментировать, IP-строки убрать) ---
# DOMAIN=questix.example.com
# CADDYFILE=./deploy/Caddyfile.domain
# VITE_API_URL=https://api.questix.example.com
# VITE_SOCKET_URL=https://api.questix.example.com
# CORS_ORIGIN=https://questix.example.com
